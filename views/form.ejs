<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isEdit ? 'Edit Student' : 'Add Student' %> - Student Records Manager</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand">
        <h1><a href="/students">Student Records Manager</a></h1>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h2><%= isEdit ? 'Edit Student' : 'Add New Student' %></h2>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>

    <div class="form-container">
      <form method="POST" action="<%= isEdit ? '/students/' + student.id : '/students' %>">
        <div class="form-group">
          <label for="name">Name *</label>
          <input type="text" id="name" name="name" value="<%= student ? student.name : '' %>" required>
        </div>

        <div class="form-group">
          <label for="age">Age *</label>
          <input type="number" id="age" name="age" value="<%= student ? student.age : '' %>" min="1" max="120" required>
        </div>

        <div class="form-group">
          <label for="course">Course *</label>
          <input type="text" id="course" name="course" value="<%= student ? student.course : '' %>" required>
        </div>

        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" name="email" value="<%= student ? student.email : '' %>" required>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Student' : 'Add Student' %></button>
          <a href="/students" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <footer>
    <p>&copy; Student Records Management</p>
  </footer>
</body>
</html>
